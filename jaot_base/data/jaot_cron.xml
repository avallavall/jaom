<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Async solve reconciliation (SPECS §4.4, D5). Odoo 19 ir.cron cannot
        go finer than one minute (interval_type minimum is 'minutes'), so the
        spec's 10 s poll target is bounded to the scheduler's 1-minute
        granularity; the config poll_interval field is kept for semantics.
        Idempotent: keyed by jaot_task_id, a known task is re-polled, never
        re-submitted.
    -->
    <record id="ir_cron_jaot_reconcile" model="ir.cron">
        <field name="name">JAOT: reconcile scenarios</field>
        <field name="model_id" ref="model_jaot_scenario"/>
        <field name="state">code</field>
        <field name="code">object.reconcile_jaot_scenarios()</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
