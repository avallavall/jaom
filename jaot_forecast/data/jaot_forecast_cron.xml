<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Optional daily forecast refresh (SPECS 13.5). Refreshing is normally
        an explicit action; this cron keeps the forecasts (and their
        demand rows) current across all companies. Inactive by default so
        installs that only want on-demand refreshes are unaffected.
    -->
    <record id="ir_cron_jaot_forecast_refresh" model="ir.cron">
        <field name="name">JAOT: refresh demand forecasts</field>
        <field name="model_id" ref="model_jaot_forecast"/>
        <field name="state">code</field>
        <field name="code">env['jaot.forecast'].refresh_all()</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
