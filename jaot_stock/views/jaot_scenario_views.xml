<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scenario UI (list + form with states, Apply/Revert, KPI and the line
         diff) already lives in jaot_base; this makes it reachable from the
         Inventory / Operations area (PLAN P3.5). -->
    <record id="action_jaot_scenario_vrp" model="ir.actions.act_window">
        <field name="name">Routing scenarios</field>
        <field name="res_model">jaot.scenario</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_no_content_smallest">
                Create a routing scenario, solve it, review the per-picking
                assignment, then apply it.
            </p>
        </field>
    </record>

    <menuitem id="menu_jaot_scenario_vrp"
              name="Routing scenarios"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_jaot_scenario_vrp"
              sequence="90"/>

    <!-- Intraday re-optimization (SPECS 13.4): the Re-optimize button,
         visible on an applied, stale routing scenario. -->
    <record id="view_jaot_scenario_form" model="ir.ui.view">
        <field name="name">jaot.scenario.form.vrp</field>
        <field name="model">jaot.scenario</field>
        <field name="inherit_id" ref="jaot_base.view_jaot_scenario_form"/>
        <field name="arch" type="xml">
            <button name="action_revert" position="after">
                <button name="action_reoptimize" type="object"
                        string="Re-optimize" class="btn-secondary"
                        confirm="Re-route the remaining pickings? Served legs keep their vehicle and position; only the changed pickings are re-planned."
                        invisible="state != 'applied' or not data_stale or not is_vrp"
                        groups="jaot_base.group_manager"/>
            </button>
            <field name="name" position="after">
                <!-- loaded so the modifier above can read it -->
                <field name="is_vrp" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
