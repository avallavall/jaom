#. module: jaot_mrp
msgid "%(order)s keeps its current start day %(day)s"
msgstr "%(order)s mantiene su día de inicio actual %(day)s"

#. module: jaot_mrp
msgid "%(order)s must be delivered in full by %(day)s"
msgstr "%(order)s debe entregarse por completo antes del %(day)s"

#. module: jaot_mrp
msgid "An order"
msgstr "Un pedido"

#. module: jaot_mrp
msgid "Create a scheduling scenario over the production orders,\n                solve it, review the start dates, then apply it."
msgstr "Cree un escenario de planificación sobre los pedidos de producción,\n                resuélvalo, revise las fechas de inicio y, a continuación, aplíquelo."

#. module: jaot_mrp
msgid "Display Name"
msgstr "Nombre de visualización"

#. module: jaot_mrp
msgid "Forecast demand must be produced by %(day)s"
msgstr "La demanda prevista debe producirse antes del %(day)s"

#. module: jaot_mrp
msgid "ID"
msgstr "ID"

#. module: jaot_mrp
msgid "Inventory holding"
msgstr "Coste de almacenamiento"

#. module: jaot_mrp
msgid "JAOT scenario"
msgstr "Escenario JAOT"

#. module: jaot_mrp
msgid "JAOT scheduling"
msgstr "Planificación JAOT"

#. module: jaot_mrp
msgid "Manufacturing Order"
msgstr "Pedido de fabricación"

#. module: jaot_mrp
msgid "Order %(name)s"
msgstr "Pedido %(name)s"

#. module: jaot_mrp
msgid "Production capacity for %(day)s"
msgstr "Capacidad de producción del %(day)s"

#. module: jaot_mrp
msgid "Production scheduling (lot sizing)"
msgstr "Planificación de producción (dimensionado de lotes)"

#. module: jaot_mrp
msgid "Scheduling scenarios"
msgstr "Escenarios de planificación"

#. module: jaot_mrp
msgid "Setups"
msgstr "Puestas a punto"

#. module: jaot_mrp
msgid "Start %(day)s"
msgstr "Inicio %(day)s"

#. module: jaot_mrp
msgid "The last scenario whose applied solution wrote the start date for this production order."
msgstr "El último escenario cuya solución aplicada escribió la fecha de inicio de este pedido de fabricación."
